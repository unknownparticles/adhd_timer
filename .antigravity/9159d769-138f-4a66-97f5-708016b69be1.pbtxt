        replacement_content: "<!doctype html>\n<html lang=\"zh-CN\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>\351\207\215\345\212\233\350\256\241\346\227\266\345\231\250 | Gravity Timer</title>\n    \n    <!-- PWA & Mobile Web App Meta Tags -->\n    <link rel=\"manifest\" href=\"/manifest.json\" />\n    <meta name=\"theme-color\" content=\"#090d16\" />\n    <meta name=\"apple-mobile-web-app-capable\" content=\"yes\" />\n    <meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\" />\n    <meta name=\"apple-mobile-web-app-title\" content=\"\351\207\215\345\212\233\350\256\241\346\227\266\" />\n    <link rel=\"apple-touch-icon\" href=\"https://cdn-icons-png.flaticon.com/512/3565/3565432.png\" />\n  </head>\n  <body class=\"bg-slate-950 text-slate-100 overflow-x-hidden\">\n    <div id=\"root\"></div>\n    <script type=\"module\" src=\"/src/main.tsx\"></script>\n    \n    <!-- PWA Service Worker Registration -->\n    <script>\n      if (\'serviceWorker\' in navigator) {\n        window.addEventListener(\'load\', () => {\n          navigator.serviceWorker.register(\'/sw.js\')\n            .then(reg => console.log(\'Service Worker registered successfully!\', reg.scope))\n            .catch(err => console.log(\'Service Worker registration failed:\', err));\n        });\n      }\n    </script>\n  </body>\n</html>"
