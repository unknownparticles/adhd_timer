    instruction: "Restyle the PhoneSimulator to use a gorgeous warm-minimalist editorial design with stone-themed buttons and phone cases"
    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <div className=\"flex flex-col h-full bg-slate-900/40 backdrop-blur-md rounded-3xl border border-slate-800 p-6 shadow-xl select-none\">\n      {/* Simulator Header */}\n      <div className=\"flex items-center justify-between mb-4\">\n        <div className=\"flex items-center gap-2\">\n          <div className=\"w-2.5 h-2.5 rounded-full bg-blue-500 animate-pulse\" />\n          <h2 className=\"text-sm font-semibold text-slate-200 tracking-wide uppercase\">\n            3D \347\211\251\347\220\206\345\247\277\346\200\201\346\250\241\346\213\237\345\231\250\n          </h2>\n        </div>\n        <span className=\"text-xs bg-slate-800 text-slate-400 px-2.5 py-1 rounded-full font-mono\">\n          {sensorData.usingSimulator ? \"\346\250\241\346\213\237\346\250\241\345\274\217\" : \"\347\211\251\347\220\206\344\274\240\346\204\237\345\231\250\346\250\241\345\274\217\"}\n        </span>\n      </div>\n\n      {/* Simulator Viewport Container */}\n      <div \n        className=\"relative flex-1 min-h-[280px] bg-slate-950 rounded-2xl border border-slate-800/80 overflow-hidden flex flex-col items-center justify-center p-4\"\n        style={{ perspective: \"1000px\" }}\n        onMouseEnter={() => setIsHovered(true)}\n        onMouseLeave={() => setIsHovered(false)}\n      >\n        {/* Virtual Table/Surface representation */}\n        <div \n          className=\"absolute bottom-6 w-[85%] h-1 bg-gradient-to-r from-transparent via-slate-800 to-transparent blur-[1px]\" \n          style={{ transform: \"rotateX(75deg)\" }}\n        />\n\n        {/* 3D Phone Body */}\n        <motion.div\n          animate={get3DRotation()}\n          transition={{ type: \"spring\", stiffness: 90, damping: 20 }}\n          className=\"relative w-36 h-72 rounded-[28px] shadow-2xl cursor-grab active:cursor-grabbing preserve-3d\"\n          style={{ transformStyle: \"preserve-3d\" }}\n        >\n          {/* FRONT Side of the Phone (Screen) */}\n          <div \n            className={`absolute inset-0 bg-slate-950 border-4 border-slate-800 rounded-[28px] flex flex-col overflow-hidden backface-hidden shadow-inner`}\n            style={{ \n              backfaceVisibility: \"hidden\",\n              boxShadow: isTimerRunning && activeFaceState === DeviceFaceState.FACE_DOWN \n                ? \"0 0 15px rgba(244,63,94,0.4)\" \n                : \"0 10px 25px rgba(0,0,0,0.5)\"\n            }}\n          >\n            {/* Top Notch / Camera Cutout */}\n            <div className=\"absolute top-0 left-1/2 transform -translate-x-1/2 w-16 h-4 bg-slate-800 rounded-b-xl z-20 flex items-center justify-center\">\n              <div className=\"w-1.5 h-1.5 rounded-full bg-slate-900 mr-2\" />\n              <div className=\"w-6 h-0.5 bg-slate-700 rounded-full\" />\n            </div>\n\n            {/* Simulated Mobile Interface */}\n            <div className=\"flex-1 flex flex-col justify-between p-3 pt-6 pb-4 select-none relative\">\n              {/* Dynamic status line */}\n              <div className=\"flex justify-between items-center text-[9px] text-slate-500 font-mono\">\n                <span>09:41</span>\n                <div className=\"flex items-center gap-1\">\n                  <div className=\"w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse\" />\n                  <span>GRAV</span>\n                </div>\n              </div>\n\n              {/* Central Screen Area */}\n              <div className=\"flex-1 flex flex-col justify-center items-center text-center\">\n                {activeFaceState === DeviceFaceState.FACE_UP ? (\n                  <div className=\"space-y-1\">\n                    <span className=\"text-[10px] text-slate-400 font-semibold uppercase tracking-wider block\">\n                      \346\224\276\347\275\256\351\235\242\346\234\235\344\270\212\n                    </span>\n                    <span className=\"text-lg font-bold font-mono tracking-widest text-slate-200\">\n                      PAUSED\n                    </span>\n                    <p className=\"text-[8px] text-slate-500 leading-tight px-2\">\n                      \347\277\273\350\275\254\350\207\263\351\235\242\346\234\235\344\270\213\345\215\263\345\217\257\345\274\200\345\247\213\350\256\241\346\227\266\n                    </p>\n                  </div>\n                ) : activeFaceState === DeviceFaceState.FACE_DOWN ? (\n                  <div className=\"space-y-1 animate-pulse\">\n                    <span className=\"text-[10px] text-rose-400 font-semibold uppercase tracking-wider block\">\n                      \344\270\223\346\263\250\350\256\241\346\227\266\344\270\255\n                    </span>\n                    <span className=\"text-xl font-bold font-mono tracking-widest text-rose-500\">\n                      Ticking\n                    </span>\n                  </div>\n                ) : currentMode ? (\n                  <div className=\"space-y-1\">\n                    <span className={`text-[9px] px-1.5 py-0.5 rounded font-medium ${colorTheme.bg} ${colorTheme.text} inline-block uppercase tracking-wider`}>\n                      {currentMode.label.split(\" \")[0]}\n                    </span>\n                    <span className=\"text-xl font-extrabold font-mono text-slate-100 block\">\n                      {formattedTime}\n                    </span>\n                    <span className=\"text-[8px] text-slate-400 line-clamp-2 px-1\">\n                      {currentMode.description.split(\"\357\274\232\")[1] || currentMode.description}\n                    </span>\n                  </div>\n                ) : (\n                  <span className=\"text-[10px] text-slate-500\">\345\200\276\346\226\234\346\211\213\346\234\272\344\273\245 \351\200\211\346\213\251\346\250\241\345\274\217</span>\n                )}\n              </div>\n\n              {/* Bottom Home Indicator / Active Accent Light */}\n              <div className=\"flex flex-col items-center gap-1.5 mt-auto\">\n                {currentMode && (\n                  <div className={`w-2 h-2 rounded-full ${colorTheme.accent} shadow-lg`} />\n                )}\n                <div className=\"w-12 h-1 bg-slate-800 rounded-full\" />\n              </div>\n            </div>\n          </div>\n\n          {/* BACK Side of the Phone (Case) */}\n          <div \n            className=\"absolute inset-0 bg-slate-800 border-4 border-slate-700 rounded-[28px] flex flex-col p-4 justify-between items-center text-slate-500\"\n            style={{ \n              transform: \"rotateY(180deg)\",\n              backfaceVisibility: \"hidden\" \n            }}\n          >\n            {/* Camera Module */}\n            <div className=\"w-10 h-10 bg-slate-900 rounded-xl p-1 flex flex-wrap gap-1 items-center justify-center shadow-lg\">\n              <div className=\"w-3.5 h-3.5 rounded-full bg-slate-950 border border-slate-800 flex items-center justify-center\">\n                <div className=\"w-1.5 h-1.5 rounded-full bg-blue-950\" />\n              </div>\n              <div className=\"w-3.5 h-3.5 rounded-full bg-slate-950 border border-slate-800 flex items-center justify-center\">\n                <div className=\"w-1.5 h-1.5 rounded-full bg-blue-950\" />\n              </div>\n              <div className=\"w-2 h-2 rounded-full bg-slate-700\" />\n            </div>\n\n            {/* Gravity Logo */}\n            <div className=\"flex flex-col items-center gap-1.5 my-auto text-slate-400\">\n              <div className=\"w-8 h-8 rounded-full border border-slate-600 flex items-center justify-center bg-slate-900/60 shadow-inner\">\n                <Smartphone className=\"w-4 h-4 text-slate-400\" />\n              </div>\n              <span className=\"text-[9px] uppercase font-bold tracking-widest text-slate-500\">\n                GRAVITY TIMER\n              </span>\n            </div>\n\n            {/* Bottom Brand */}\n            <span className=\"text-[7px] font-mono tracking-wider text-slate-600\">\n              DESIGNED FOR CALM\n            </span>\n          </div>\n        </motion.div>\n\n        {/* Angle Readout & Description Overlay */}\n        <div className=\"absolute top-3 left-3 flex flex-col gap-0.5 text-[10px] font-mono text-slate-500 bg-slate-950/80 p-2 rounded-lg border border-slate-900 select-text\">\n          <div>Pitch (Beta): {Math.round(sensorData.beta)}\302\260</div>\n          <div>Roll (Gamma): {Math.round(sensorData.gamma)}\302\260</div>\n        </div>\n\n        {/* Dynamic State Overlay Indicator */}\n        <div className=\"absolute bottom-3 left-1/2 transform -translate-x-1/2 text-center\">\n          <p className=\"text-[11px] text-slate-300 font-medium px-3 py-1 bg-slate-900/90 border border-slate-800 rounded-full flex items-center gap-1.5 shadow-md\">\n            <span>{getPresetLabel()}</span>\n          </p>\n        </div>\n      </div>\n\n      {/* Simulator Control Presets Grid */}\n      <div className=\"mt-4 space-y-2\">\n        <span className=\"text-[11px] font-medium text-slate-400 block px-1\">\n          \347\202\271\345\207\273\351\242\204\350\256\276\347\212\266\346\200\201\346\250\241\346\213\237\351\207\215\345\212\233\346\227\213\350\275\254\357\274\232\n        </span>\n\n        <div className=\"grid grid-cols-2 gap-2\">\n          {/* Flat States */}\n          <button\n            onClick={() => applyPreset({ beta: 0, gamma: 0, label: \"Face Up\" })}\n            className={`flex items-center justify-center gap-1.5 py-2 px-3 rounded-xl border text-xs font-medium transition-all ${\n              activeFaceState === DeviceFaceState.FACE_UP\n                ? \"bg-blue-600/20 text-blue-400 border-blue-500/50 shadow-md shadow-blue-500/10\"\n                : \"bg-slate-800/50 hover:bg-slate-800 text-slate-300 border-slate-700/80\"\n            }`}\n          >\n            <Smartphone className=\"w-3.5 h-3.5 rotate-180\" />\n            \351\235\242\346\234\235\344\270\212 (\346\232\202\345\201\234)\n          </button>\n\n          <button\n            onClick={() => applyPreset({ beta: 180, gamma: 0, label: \"Face Down\" })}\n            className={`flex items-center justify-center gap-1.5 py-2 px-3 rounded-xl border text-xs font-medium transition-all ${\n              activeFaceState === DeviceFaceState.FACE_DOWN\n                ? \"bg-rose-600/20 text-rose-400 border-rose-500/50 shadow-md shadow-rose-500/10\"\n                : \"bg-slate-800/50 hover:bg-slate-800 text-slate-300 border-slate-700/80\"\n            }`}\n          >\n            <Smartphone className=\"w-3.5 h-3.5\" />\n            \351\235\242\346\234\235\344\270\213 (\345\274\200\345\247\213)\n          </button>\n        </div>\n\n        {/* Cardinal Directions */}\n        <div className=\"grid grid-cols-2 gap-2\">\n          {/* Portrait Up */}\n          <button\n            onClick={() => applyPreset({ beta: 75, gamma: 0, label: \"Portrait Up\" })}\n            className={`flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-xl border text-[11px] font-medium transition-all ${\n              activeDirection === TimerDirection.PORTRAIT_UP && activeFaceState === DeviceFaceState.TILTED\n                ? \"bg-rose-500/20 text-rose-400 border-rose-500/40\"\n                : \"bg-slate-800/30 hover:bg-slate-800 text-slate-400 border-slate-800\"\n            }`}\n          >\n            <ChevronUp className=\"w-3.5 h-3.5\" />\n            \347\253\226\345\261\217\345\220\221\344\270\212 ({modes[TimerDirection.PORTRAIT_UP].duration}m)\n          </button>\n\n          {/* Landscape Right */}\n          <button\n            onClick={() => applyPreset({ beta: 0, gamma: 75, label: \"Landscape Right\" })}\n            className={`flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-xl border text-[11px] font-medium transition-all ${\n              activeDirection === TimerDirection.LANDSCAPE_RIGHT && activeFaceState === DeviceFaceState.TILTED\n                ? \"bg-emerald-500/20 text-emerald-400 border-emerald-500/40\"\n                : \"bg-slate-800/30 hover:bg-slate-800 text-slate-400 border-slate-800\"\n            }`}\n          >\n            <CornerRightDown className=\"w-3.5 h-3.5\" />\n            \346\250\252\345\261\217\345\220\221\345\217\263 ({modes[TimerDirection.LANDSCAPE_RIGHT].duration}m)\n          </button>\n\n          {/* Portrait Down */}\n          <button\n            onClick={() => applyPreset({ beta: -75, gamma: 0, label: \"Portrait Down\" })}\n            className={`flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-xl border text-[11px] font-medium transition-all ${\n              activeDirection === TimerDirection.PORTRAIT_DOWN && activeFaceState === DeviceFaceState.TILTED\n                ? \"bg-indigo-500/20 text-indigo-400 border-indigo-500/40\"\n                : \"bg-slate-800/30 hover:bg-slate-800 text-slate-400 border-slate-800\"\n            }`}\n          >\n            <RotateCcw className=\"w-3.5 h-3.5\" />\n            \347\253\226\345\261\217\345\220\221\344\270\213 ({modes[TimerDirection.PORTRAIT_DOWN].duration}m)\n          </button>\n\n          {/* Landscape Left */}\n          <button\n            onClick={() => applyPreset({ beta: 0, gamma: -75, label: \"Landscape Left\" })}\n            className={`flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-xl border text-[11px] font-medium transition-all ${\n              activeDirection === TimerDirection.LANDSCAPE_LEFT && activeFaceState === DeviceFaceState.TILTED\n                ? \"bg-amber-500/20 text-amber-400 border-amber-500/40\"\n                : \"bg-slate-800/30 hover:bg-slate-800 text-slate-400 border-slate-800\"\n            }`}\n          >\n            <CornerUpLeft className=\"w-3.5 h-3.5\" />\n            \346\250\252\345\261\217\345\220\221\345\267\246 ({modes[TimerDirection.LANDSCAPE_LEFT].duration}m)\n          </button>\n        </div>\n\n        {/* Tip */}\n        <p className=\"text-[10px] text-slate-500 text-center flex items-center justify-center gap-1 pt-1 font-sans\">\n          <Sparkles className=\"w-3 h-3 text-amber-500 animate-pulse\" />\n          <span>\346\224\257\346\214\201\345\244\232\346\214\207\345\234\2503D\350\247\206\347\252\227\344\270\212\346\273\221\345\212\250\346\210\226\347\233\264\346\216\245\347\202\271\345\207\273\351\242\204\350\256\276\346\235\245\346\265\213\350\257\225\343\200\202</span>\n        </p>\n      </div>\n    </div>\n  );"
        replacement_content: "  return (\n    <div className=\"flex flex-col h-full bg-white rounded-3xl border border-stone-200/80 p-6 shadow-sm select-none\">\n      {/* Simulator Header */}\n      <div className=\"flex items-center justify-between mb-4\">\n        <div className=\"flex items-center gap-2\">\n          <div className=\"w-2 h-2 rounded-full bg-stone-400\" />\n          <h2 className=\"text-xs font-bold text-stone-800 tracking-wider uppercase\">\n            3D \347\211\251\347\220\206\345\247\277\346\200\201\346\250\241\346\213\237\345\231\250\n          </h2>\n        </div>\n        <span className=\"text-[10px] bg-stone-100 text-stone-600 px-2.5 py-1 rounded-full font-mono\">\n          {sensorData.usingSimulator ? \"\350\231\232\346\213\237\346\250\241\345\274\217\" : \"\347\234\237\346\234\272\344\274\240\346\204\237\345\231\250\"}\n        </span>\n      </div>\n\n      {/* Simulator Viewport Container */}\n      <div \n        className=\"relative flex-1 min-h-[280px] bg-[#FAF9F6] rounded-2xl border border-stone-200/60 overflow-hidden flex flex-col items-center justify-center p-4\"\n        style={{ perspective: \"1000px\" }}\n        onMouseEnter={() => setIsHovered(true)}\n        onMouseLeave={() => setIsHovered(false)}\n      >\n        {/* Virtual Table/Surface representation */}\n        <div \n          className=\"absolute bottom-6 w-[85%] h-1 bg-gradient-to-r from-transparent via-stone-200 to-transparent blur-[1px]\" \n          style={{ transform: \"rotateX(75deg)\" }}\n        />\n\n        {/* 3D Phone Body */}\n        <motion.div\n          animate={get3DRotation()}\n          transition={{ type: \"spring\", stiffness: 90, damping: 20 }}\n          className=\"relative w-36 h-72 rounded-[24px] shadow-lg cursor-grab active:cursor-grabbing preserve-3d\"\n          style={{ transformStyle: \"preserve-3d\" }}\n        >\n          {/* FRONT Side of the Phone (Screen) */}\n          <div \n            className=\"absolute inset-0 bg-white border-4 border-stone-300 rounded-[24px] flex flex-col overflow-hidden backface-hidden shadow-inner\"\n            style={{ \n              backfaceVisibility: \"hidden\",\n              boxShadow: \"0 10px 25px rgba(0,0,0,0.05)\"\n            }}\n          >\n            {/* Top Speaker / Notch */}\n            <div className=\"absolute top-0 left-1/2 transform -translate-x-1/2 w-16 h-3 bg-stone-200 rounded-b-lg z-20 flex items-center justify-center\">\n              <div className=\"w-4 h-0.5 bg-stone-400 rounded-full\" />\n            </div>\n\n            {/* Simulated Mobile Interface */}\n            <div className=\"flex-1 flex flex-col justify-between p-3 pt-5 pb-4 select-none relative\">\n              {/* Dynamic status line */}\n              <div className=\"flex justify-between items-center text-[9px] text-stone-400 font-mono\">\n                <span>09:41</span>\n                <div className=\"flex items-center gap-1\">\n                  <div className=\"w-1 h-1 rounded-full bg-stone-400\" />\n                  <span>GRAV</span>\n                </div>\n              </div>\n\n              {/* Central Screen Area */}\n              <div className=\"flex-1 flex flex-col justify-center items-center text-center\">\n                {activeFaceState === DeviceFaceState.FACE_UP ? (\n                  <div className=\"space-y-1\">\n                    <span className=\"text-[9px] text-stone-400 font-bold uppercase tracking-wider block\">\n                      \346\224\276\347\275\256\351\235\242\346\234\235\344\270\212\n                    </span>\n                    <span className=\"text-base font-bold font-mono tracking-wider text-stone-800\">\n                      PAUSED\n                    </span>\n                    <p className=\"text-[8px] text-stone-400 leading-tight px-1\">\n                      \347\277\273\350\275\254\346\211\243\344\270\213\345\215\263\345\217\257\345\274\200\345\247\213\n                    </p>\n                  </div>\n                ) : activeFaceState === DeviceFaceState.FACE_DOWN ? (\n                  <div className=\"space-y-1\">\n                    <span className=\"text-[9px] text-stone-500 font-semibold uppercase tracking-wider block\">\n                      \344\270\223\346\263\250\350\256\241\346\227\266\344\270\255\n                    </span>\n                    <span className=\"text-base font-bold font-mono tracking-wider text-stone-700 animate-pulse\">\n                      Ticking\n                    </span>\n                  </div>\n                ) : currentMode ? (\n                  <div className=\"space-y-1\">\n                    <span className=\"text-[9px] px-1.5 py-0.5 rounded font-medium bg-stone-100 text-stone-700 inline-block uppercase tracking-wider\">\n                      {currentMode.label.split(\" \")[0]}\n                    </span>\n                    <span className=\"text-lg font-bold font-mono text-stone-800 block\">\n                      {formattedTime}\n                    </span>\n                    <span className=\"text-[8px] text-stone-400 line-clamp-2 px-1\">\n                      {currentMode.description.split(\"\357\274\232\")[1] || currentMode.description}\n                    </span>\n                  </div>\n                ) : (\n                  <span className=\"text-[9px] text-stone-400\">\345\200\276\346\226\234\351\200\211\346\213\251\346\250\241\345\274\217</span>\n                )}\n              </div>\n\n              {/* Bottom Home Indicator */}\n              <div className=\"flex flex-col items-center gap-1.5 mt-auto\">\n                <div className=\"w-10 h-0.5 bg-stone-300 rounded-full\" />\n              </div>\n            </div>\n          </div>\n\n          {/* BACK Side of the Phone (Case) */}\n          <div \n            className=\"absolute inset-0 bg-stone-100 border-4 border-stone-200 rounded-[24px] flex flex-col p-4 justify-between items-center text-stone-400\"\n            style={{ \n              transform: \"rotateY(180deg)\",\n              backfaceVisibility: \"hidden\" \n            }}\n          >\n            {/* Camera Module */}\n            <div className=\"w-8 h-8 bg-stone-200 rounded-lg p-1 flex items-center justify-center shadow-inner\">\n              <div className=\"w-4 h-4 rounded-full bg-stone-300 flex items-center justify-center\">\n                <div className=\"w-1.5 h-1.5 rounded-full bg-stone-400\" />\n              </div>\n            </div>\n\n            {/* Gravity Logo */}\n            <div className=\"flex flex-col items-center gap-1.5 my-auto text-stone-500\">\n              <div className=\"w-7 h-7 rounded-full border border-stone-300 flex items-center justify-center bg-white shadow-sm\">\n                <Smartphone className=\"w-3.5 h-3.5 text-stone-400\" />\n              </div>\n              <span className=\"text-[8px] uppercase font-bold tracking-widest text-stone-500\">\n                GRAVITY\n              </span>\n            </div>\n\n            {/* Bottom Brand */}\n            <span className=\"text-[7px] font-mono tracking-wider text-stone-400\">\n              MINIMAL\n            </span>\n          </div>\n        </motion.div>\n\n        {/* Angle Readout */}\n        <div className=\"absolute top-3 left-3 flex flex-col gap-0.5 text-[9px] font-mono text-stone-400 bg-white/95 px-2 py-1 rounded border border-stone-200/60 shadow-sm select-text\">\n          <div>Pitch: {Math.round(sensorData.beta)}\302\260</div>\n          <div>Roll: {Math.round(sensorData.gamma)}\302\260</div>\n        </div>\n\n        {/* Dynamic State Overlay Indicator */}\n        <div className=\"absolute bottom-3 left-1/2 transform -translate-x-1/2 text-center\">\n          <p className=\"text-[10px] text-stone-600 font-medium px-3 py-1 bg-white border border-stone-200 rounded-full flex items-center gap-1.5 shadow-sm\">\n            <span>{getPresetLabel()}</span>\n          </p>\n        </div>\n      </div>\n\n      {/* Simulator Control Presets Grid */}\n      <div className=\"mt-4 space-y-2\">\n        <span className=\"text-[11px] font-bold text-stone-500 block px-1\">\n          \347\212\266\346\200\201\351\242\204\350\256\276\357\274\210\347\202\271\345\207\273\346\250\241\346\213\237\346\227\213\350\275\254\357\274\211\357\274\232\n        </span>\n\n        <div className=\"grid grid-cols-2 gap-2\">\n          {/* Flat States */}\n          <button\n            onClick={() => applyPreset({ beta: 0, gamma: 0, label: \"Face Up\" })}\n            className={`flex items-center justify-center gap-1.5 py-1.5 px-3 rounded-xl border text-xs font-medium transition-all ${\n              activeFaceState === DeviceFaceState.FACE_UP\n                ? \"bg-stone-900 text-white border-stone-900\"\n                : \"bg-white hover:bg-stone-50 text-stone-700 border-stone-200\"\n            }`}\n          >\n            <Smartphone className=\"w-3.5 h-3.5 rotate-180\" />\n            \351\235\242\346\234\235\344\270\212 (\346\232\202\345\201\234)\n          </button>\n\n          <button\n            onClick={() => applyPreset({ beta: 180, gamma: 0, label: \"Face Down\" })}\n            className={`flex items-center justify-center gap-1.5 py-1.5 px-3 rounded-xl border text-xs font-medium transition-all ${\n              activeFaceState === DeviceFaceState.FACE_DOWN\n                ? \"bg-stone-900 text-white border-stone-900\"\n                : \"bg-white hover:bg-stone-50 text-stone-700 border-stone-200\"\n            }`}\n          >\n            <Smartphone className=\"w-3.5 h-3.5\" />\n            \351\235\242\346\234\235\344\270\213 (\350\256\241\346\227\266)\n          </button>\n        </div>\n\n        {/* Cardinal Directions */}\n        <div className=\"grid grid-cols-2 gap-2\">\n          {/* Portrait Up */}\n          <button\n            onClick={() => applyPreset({ beta: 75, gamma: 0, label: \"Portrait Up\" })}\n            className={`flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-xl border text-[11px] font-medium transition-all ${\n              activeDirection === TimerDirection.PORTRAIT_UP && activeFaceState === DeviceFaceState.TILTED\n                ? \"bg-stone-200 text-stone-800 border-stone-300\"\n                : \"bg-stone-50 hover:bg-stone-100 text-stone-600 border-stone-200/80\"\n            }`}\n          >\n            <ChevronUp className=\"w-3 h-3\" />\n            \347\253\226\345\261\217\346\234\235\344\270\212 ({modes[TimerDirection.PORTRAIT_UP].duration}\345\210\206)\n          </button>\n\n          {/* Landscape Right */}\n          <button\n            onClick={() => applyPreset({ beta: 0, gamma: 75, label: \"Landscape Right\" })}\n            className={`flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-xl border text-[11px] font-medium transition-all ${\n              activeDirection === TimerDirection.LANDSCAPE_RIGHT && activeFaceState === DeviceFaceState.TILTED\n                ? \"bg-stone-200 text-stone-800 border-stone-300\"\n                : \"bg-stone-50 hover:bg-stone-100 text-stone-600 border-stone-200/80\"\n            }`}\n          >\n            <CornerRightDown className=\"w-3 h-3\" />\n            \346\250\252\345\261\217\345\220\221\345\217\263 ({modes[TimerDirection.LANDSCAPE_RIGHT].duration}\345\210\206)\n          </button>\n\n          {/* Portrait Down */}\n          <button\n            onClick={() => applyPreset({ beta: -75, gamma: 0, label: \"Portrait Down\" })}\n            className={`flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-xl border text-[11px] font-medium transition-all ${\n              activeDirection === TimerDirection.PORTRAIT_DOWN && activeFaceState === DeviceFaceState.TILTED\n                ? \"bg-stone-200 text-stone-800 border-stone-300\"\n                : \"bg-stone-50 hover:bg-stone-100 text-stone-600 border-stone-200/80\"\n            }`}\n          >\n            <RotateCcw className=\"w-3 h-3\" />\n            \347\253\226\345\261\217\346\234\235\344\270\213 ({modes[TimerDirection.PORTRAIT_DOWN].duration}\345\210\206)\n          </button>\n\n          {/* Landscape Left */}\n          <button\n            onClick={() => applyPreset({ beta: 0, gamma: -75, label: \"Landscape Left\" })}\n            className={`flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-xl border text-[11px] font-medium transition-all ${\n              activeDirection === TimerDirection.LANDSCAPE_LEFT && activeFaceState === DeviceFaceState.TILTED\n                ? \"bg-stone-200 text-stone-800 border-stone-300\"\n                : \"bg-stone-50 hover:bg-stone-100 text-stone-600 border-stone-200/80\"\n            }`}\n          >\n            <CornerUpLeft className=\"w-3 h-3\" />\n            \346\250\252\345\261\217\345\220\221\345\267\246 ({modes[TimerDirection.LANDSCAPE_LEFT].duration}\345\210\206)\n          </button>\n        </div>\n\n        {/* Tip */}\n        <p className=\"text-[10px] text-stone-400 text-center flex items-center justify-center gap-1 pt-1 font-sans\">\n          <span>\345\217\257\344\273\245\347\233\264\346\216\245\346\213\226\346\213\2753D\350\247\206\347\252\227\346\227\213\350\275\254\346\211\213\346\234\272\357\274\214\346\210\226\347\202\271\345\207\273\344\270\212\346\226\271\346\214\211\351\222\256\350\277\233\350\241\214\346\250\241\346\213\237</span>\n        </p>\n      </div>\n    </div>\n  );"
