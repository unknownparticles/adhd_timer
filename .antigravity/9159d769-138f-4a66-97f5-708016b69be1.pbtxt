    instruction: "Make spacing and padding inside GravityTimer fully responsive and more compact on smaller screens."
    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <div className=\"flex flex-col items-center justify-between h-full bg-white rounded-3xl border border-stone-200/80 p-6 md:p-8 shadow-sm\">\n      \n      {/* Top Banner: Gravity Sensor Status & Fast Settings */}\n      <div className=\"w-full flex justify-between items-center mb-6\">\n        <div className=\"flex items-center gap-2\">\n          {sensorPermissionState === \"granted\" ? (\n            <span className=\"flex items-center gap-1.5 text-[10px] text-stone-700 bg-stone-100 px-2.5 py-1 rounded-full font-medium border border-stone-200/60\">\n              <Compass className=\"w-3 h-3 animate-spin\" style={{ animationDuration: \'10s\' }} />\n              \347\211\251\347\220\206\344\274\240\346\204\237\345\231\250\345\267\262\350\277\236\346\216\245\n            </span>\n          ) : sensorPermissionState === \"denied\" ? (\n            <button \n              onClick={requestSensorPermissions}\n              className=\"flex items-center gap-1.5 text-[10px] text-stone-600 bg-stone-50 px-2.5 py-1 rounded-full font-medium hover:bg-stone-100 transition-all border border-stone-200\"\n            >\n              <Compass className=\"w-3 h-3 text-stone-400\" />\n              \347\202\271\345\207\273\346\277\200\346\264\273\351\207\215\345\212\233\346\204\237\345\272\224\n            </button>\n          ) : sensorPermissionState === \"prompt\" ? (\n            <button \n              onClick={requestSensorPermissions}\n              className=\"flex items-center gap-1.5 text-[10px] text-stone-900 bg-stone-100 px-2.5 py-1 rounded-full font-medium hover:bg-stone-200 transition-all cursor-pointer border border-stone-300 animate-pulse\"\n            >\n              <Compass className=\"w-3 h-3\" />\n              \346\277\200\346\264\273\351\207\215\345\212\233\346\204\237\345\272\224\n            </button>\n          ) : (\n            <span className=\"flex items-center gap-1.5 text-[10px] text-stone-500 bg-stone-50 px-2.5 py-1 rounded-full font-medium border border-stone-200/60\">\n              <Compass className=\"w-3 h-3\" />\n              \346\250\241\346\213\237\345\231\250\345\267\262\346\277\200\346\264\273\n            </span>\n          )}\n        </div>\n\n        {/* Audio Toggles */}\n        <div className=\"flex items-center gap-1.5\">\n          <button\n            onClick={() => setSettings(prev => ({ ...prev, tickingSoundEnabled: !prev.tickingSoundEnabled }))}\n            className={`px-2 py-1 rounded text-[10px] font-mono border transition-all ${\n              settings.tickingSoundEnabled\n                ? \"bg-stone-900 text-stone-100 border-stone-900\"\n                : \"bg-transparent text-stone-400 border-stone-200 hover:text-stone-700\"\n            }`}\n            title=\"\347\247\222\351\222\210\346\273\264\347\255\224\345\243\260\345\217\215\351\246\210\"\n          >\n            \346\273\264\347\255\224\345\243\260: {settings.tickingSoundEnabled ? \"\345\274\200\" : \"\345\205\263\"}\n          </button>\n          \n          <button\n            onClick={() => setSettings(prev => ({ ...prev, soundEnabled: !prev.soundEnabled }))}\n            className=\"p-1 rounded hover:bg-stone-100 text-stone-400 hover:text-stone-700 transition-all border border-stone-200\"\n            title={settings.soundEnabled ? \"\345\205\263\351\227\255\345\243\260\351\237\263\" : \"\345\274\200\345\220\257\345\243\260\351\237\263\"}\n          >\n            {settings.soundEnabled ? (\n              <Volume2 className=\"w-3.5 h-3.5 text-stone-800\" />\n            ) : (\n              <VolumeX className=\"w-3.5 h-3.5 text-stone-400\" />\n            )}\n          </button>\n        </div>\n      </div>\n\n      {/* Main Gravity Circle Visualizer */}\n      <div className=\"relative flex-1 flex flex-col items-center justify-center py-6 w-full max-w-[340px]\">\n        <svg className=\"w-64 h-64 transform -rotate-90 select-none pointer-events-none\">\n          {/* Outer Track Circle */}\n          <circle\n            cx=\"128\"\n            cy=\"128\"\n            r=\"105\"\n            className=\"stroke-stone-100 fill-none\"\n            strokeWidth=\"5\"\n          />\n\n          {/* Dynamic Progress Arc */}\n          <motion.circle\n            cx=\"128\"\n            cy=\"128\"\n            r=\"105\"\n            className=\"fill-none stroke-stone-800\"\n            strokeWidth=\"5\"\n            strokeDasharray={2 * Math.PI * 105}\n            animate={{ strokeDashoffset: (2 * Math.PI * 105) - (progressPercentage / 100) * (2 * Math.PI * 105) }}\n            transition={{ type: \"tween\", ease: \"easeInOut\", duration: 0.5 }}\n            strokeLinecap=\"round\"\n          />\n        </svg>\n\n        {/* Central Display overlay */}\n        <div className=\"absolute inset-0 flex flex-col items-center justify-center text-center p-8 select-none\">\n          <AnimatePresence mode=\"wait\">\n            <motion.div\n              key={currentMode.id}\n              initial={{ scale: 0.95, opacity: 0 }}\n              animate={{ scale: 1, opacity: 1 }}\n              exit={{ scale: 0.97, opacity: 0 }}\n              transition={{ duration: 0.2 }}\n              className=\"flex flex-col items-center gap-1\"\n            >\n              <div className=\"p-2 rounded-xl bg-stone-100 text-stone-800 border border-stone-200/60 shadow-none\">\n                {renderModeIcon(currentMode.iconName, \"w-4 h-4\")}\n              </div>\n              <h3 className=\"text-xs font-bold text-stone-500 mt-1 uppercase tracking-wider\">\n                {currentMode.label}\n              </h3>\n            </motion.div>\n          </AnimatePresence>\n\n          {/* Countdown Clock Face */}\n          <span className=\"text-4xl font-black font-mono tracking-tight text-stone-900 my-2.5\">\n            {formattedMinutes}:{formattedSeconds}\n          </span>\n\n          {/* Device Face Feedback Statement */}\n          <div className=\"h-6\">\n            {activeFaceState === DeviceFaceState.FACE_DOWN ? (\n              <span className=\"text-[10px] text-stone-600 font-bold flex items-center gap-1.5\">\n                <span className=\"w-1.5 h-1.5 rounded-full bg-stone-800 animate-ping\" />\n                \346\255\243\345\234\250\350\256\241\346\227\266\344\270\255...\n              </span>\n            ) : activeFaceState === DeviceFaceState.FACE_UP ? (\n              <span className=\"text-[10px] text-stone-400 font-medium flex items-center gap-1.5\">\n                <span className=\"w-1.5 h-1.5 rounded-full bg-stone-300\" />\n                \345\261\217\345\271\225\345\220\221\344\270\212\357\274\232\346\232\202\345\201\234\344\270\255\n              </span>\n            ) : (\n              <span className=\"text-[10px] text-stone-400 flex items-center gap-1 justify-center\">\n                <ArrowDownCircle className=\"w-3.5 h-3.5\" />\n                \345\200\222\346\211\243\346\211\213\346\234\272\345\274\200\345\247\213\344\270\223\346\263\250\n              </span>\n            )}\n          </div>\n        </div>\n      </div>\n\n      {/* Dynamic Instruction Cards */}\n      <div className=\"w-full mt-4\">\n        {/* Quick Help Tip */}\n        <div className=\"bg-[#FAF9F6] rounded-2xl p-4 border border-stone-200/60 text-center\">\n          <h4 className=\"text-[11px] font-bold text-stone-700 flex items-center justify-center gap-1 mb-1.5\">\n            \346\223\215\344\275\234\346\214\207\345\215\227\n          </h4>\n          <p className=\"text-[10px] text-stone-500 leading-relaxed font-sans max-w-[280px] mx-auto\">\n            1. \346\227\213\350\275\254/\345\200\276\346\226\234\346\211\213\346\234\272\357\274\210\346\210\226\345\267\246\344\276\2473D\346\250\241\346\213\237\345\231\250\357\274\211\351\200\211\346\213\251\350\256\241\346\227\266\346\250\241\345\274\217<br />\n            2. \345\261\217\345\271\225<strong className=\"text-stone-700\">\345\200\222\346\211\243\351\235\242\346\234\235\344\270\213</strong>\357\274\214\345\215\263\345\217\257\345\274\200\345\247\213\346\210\226\346\201\242\345\244\215\350\256\241\346\227\266<br />\n            3. \345\261\217\345\271\225<strong className=\"text-stone-700\">\351\235\242\346\234\235\344\270\212\346\224\276\347\275\256</strong>\357\274\214\350\256\241\346\227\266\345\231\250\350\207\252\345\212\250\346\232\202\345\201\234\n          </p>\n        </div>\n\n        {/* Manual Overrides for testing and accessibility fallback */}\n        <div className=\"flex justify-center items-center gap-3 mt-4 pt-3 border-t border-stone-100\">\n          <button\n            onClick={() => setIsTimerRunning(!isTimerRunning)}\n            className={`flex items-center gap-1.5 py-2 px-4 rounded-xl text-xs font-semibold transition-all border ${\n              isTimerRunning \n                ? \"bg-white hover:bg-stone-50 text-stone-700 border-stone-200\"\n                : \"bg-stone-900 hover:bg-stone-800 text-stone-50 border-stone-900\"\n            }`}\n          >\n            {isTimerRunning ? <Pause className=\"w-3.5 h-3.5\" /> : <Play className=\"w-3.5 h-3.5\" />}\n            {isTimerRunning ? \"\346\211\213\345\212\250\346\232\202\345\201\234\" : \"\346\211\213\345\212\250\345\274\200\345\247\213\"}\n          </button>\n\n          <button\n            onClick={() => {\n              setTimeLeft(currentMode.duration * 60);\n              setIsTimerRunning(false);\n            }}\n            className=\"flex items-center gap-1.5 py-2 px-4 rounded-xl text-xs font-semibold bg-stone-100 hover:bg-stone-200 text-stone-700 transition-all border border-transparent\"\n          >\n            <RotateCcw className=\"w-3.5 h-3.5\" />\n            \351\207\215\347\275\256\n          </button>\n        </div>\n      </div>"
        replacement_content: "  return (\n    <div className=\"flex flex-col items-center justify-between h-full bg-white rounded-3xl border border-stone-200/80 p-4 sm:p-6 md:p-8 shadow-sm\">\n      \n      {/* Top Banner: Gravity Sensor Status & Fast Settings */}\n      <div className=\"w-full flex justify-between items-center mb-3 md:mb-6 shrink-0\">\n        <div className=\"flex items-center gap-2\">\n          {sensorPermissionState === \"granted\" ? (\n            <span className=\"flex items-center gap-1.5 text-[10px] text-stone-700 bg-stone-100 px-2 py-0.5 md:py-1 rounded-full font-medium border border-stone-200/60\">\n              <Compass className=\"w-3 h-3 animate-spin\" style={{ animationDuration: \'10s\' }} />\n              \347\211\251\347\220\206\344\274\240\346\204\237\345\231\250\345\267\262\350\277\236\346\216\245\n            </span>\n          ) : sensorPermissionState === \"denied\" ? (\n            <button \n              onClick={requestSensorPermissions}\n              className=\"flex items-center gap-1.5 text-[10px] text-stone-600 bg-stone-50 px-2 py-0.5 md:py-1 rounded-full font-medium hover:bg-stone-100 transition-all border border-stone-200\"\n            >\n              <Compass className=\"w-3 h-3 text-stone-400\" />\n              \347\202\271\345\207\273\346\277\200\346\264\273\351\207\215\345\212\233\346\204\237\345\272\224\n            </button>\n          ) : sensorPermissionState === \"prompt\" ? (\n            <button \n              onClick={requestSensorPermissions}\n              className=\"flex items-center gap-1.5 text-[10px] text-stone-900 bg-stone-100 px-2 py-0.5 md:py-1 rounded-full font-medium hover:bg-stone-200 transition-all cursor-pointer border border-stone-300 animate-pulse\"\n            >\n              <Compass className=\"w-3 h-3\" />\n              \346\277\200\346\264\273\351\207\215\345\212\233\346\204\237\345\272\224\n            </button>\n          ) : (\n            <span className=\"flex items-center gap-1.5 text-[10px] text-stone-500 bg-stone-50 px-2 py-0.5 md:py-1 rounded-full font-medium border border-stone-200/60\">\n              <Compass className=\"w-3 h-3\" />\n              \346\250\241\346\213\237\345\231\250\345\267\262\346\277\200\346\264\273\n            </span>\n          )}\n        </div>\n\n        {/* Audio Toggles */}\n        <div className=\"flex items-center gap-1.5\">\n          <button\n            onClick={() => setSettings(prev => ({ ...prev, tickingSoundEnabled: !prev.tickingSoundEnabled }))}\n            className={`px-1.5 py-0.5 md:px-2 md:py-1 rounded text-[10px] font-mono border transition-all ${\n              settings.tickingSoundEnabled\n                ? \"bg-stone-900 text-stone-100 border-stone-900\"\n                : \"bg-transparent text-stone-400 border-stone-200 hover:text-stone-700\"\n            }`}\n            title=\"\347\247\222\351\222\210\346\273\264\347\255\224\345\243\260\345\217\215\351\246\210\"\n          >\n            \346\273\264\347\255\224\345\243\260: {settings.tickingSoundEnabled ? \"\345\274\200\" : \"\345\205\263\"}\n          </button>\n          \n          <button\n            onClick={() => setSettings(prev => ({ ...prev, soundEnabled: !prev.soundEnabled }))}\n            className=\"p-1 rounded hover:bg-stone-100 text-stone-400 hover:text-stone-700 transition-all border border-stone-200\"\n            title={settings.soundEnabled ? \"\345\205\263\351\227\255\345\243\260\351\237\263\" : \"\345\274\200\345\220\257\345\243\260\351\237\263\"}\n          >\n            {settings.soundEnabled ? (\n              <Volume2 className=\"w-3.5 h-3.5 text-stone-800\" />\n            ) : (\n              <VolumeX className=\"w-3.5 h-3.5 text-stone-400\" />\n            )}\n          </button>\n        </div>\n      </div>\n\n      {/* Main Gravity Circle Visualizer */}\n      <div className=\"relative flex-1 flex flex-col items-center justify-center py-2 md:py-6 w-full max-w-[340px] min-h-0 overflow-hidden\">\n        <svg className=\"w-56 h-56 sm:w-64 sm:h-64 transform -rotate-90 select-none pointer-events-none shrink-0\">\n          {/* Outer Track Circle */}\n          <circle\n            cx=\"112\"\n            cy=\"112\"\n            r=\"92\"\n            className=\"stroke-stone-100 fill-none sm:hidden\"\n            strokeWidth=\"5\"\n          />\n          <circle\n            cx=\"128\"\n            cy=\"128\"\n            r=\"105\"\n            className=\"stroke-stone-100 fill-none hidden sm:block\"\n            strokeWidth=\"5\"\n          />\n\n          {/* Dynamic Progress Arc */}\n          <motion.circle\n            cx=\"112\"\n            cy=\"112\"\n            r=\"92\"\n            className=\"fill-none stroke-stone-800 sm:hidden\"\n            strokeWidth=\"5\"\n            strokeDasharray={2 * Math.PI * 92}\n            animate={{ strokeDashoffset: (2 * Math.PI * 92) - (progressPercentage / 100) * (2 * Math.PI * 92) }}\n            transition={{ type: \"tween\", ease: \"easeInOut\", duration: 0.5 }}\n            strokeLinecap=\"round\"\n          />\n          <motion.circle\n            cx=\"128\"\n            cy=\"128\"\n            r=\"105\"\n            className=\"fill-none stroke-stone-800 hidden sm:block\"\n            strokeWidth=\"5\"\n            strokeDasharray={2 * Math.PI * 105}\n            animate={{ strokeDashoffset: (2 * Math.PI * 105) - (progressPercentage / 100) * (2 * Math.PI * 105) }}\n            transition={{ type: \"tween\", ease: \"easeInOut\", duration: 0.5 }}\n            strokeLinecap=\"round\"\n          />\n        </svg>\n\n        {/* Central Display overlay */}\n        <div className=\"absolute inset-0 flex flex-col items-center justify-center text-center p-4 sm:p-8 select-none\">\n          <AnimatePresence mode=\"wait\">\n            <motion.div\n              key={currentMode.id}\n              initial={{ scale: 0.95, opacity: 0 }}\n              animate={{ scale: 1, opacity: 1 }}\n              exit={{ scale: 0.97, opacity: 0 }}\n              transition={{ duration: 0.2 }}\n              className=\"flex flex-col items-center gap-0.5 sm:gap-1\"\n            >\n              <div className=\"p-1.5 rounded-lg bg-stone-100 text-stone-800 border border-stone-200/60 shadow-none\">\n                {renderModeIcon(currentMode.iconName, \"w-3.5 h-3.5\")}\n              </div>\n              <h3 className=\"text-[10px] font-bold text-stone-500 mt-1 uppercase tracking-wider\">\n                {currentMode.label}\n              </h3>\n            </motion.div>\n          </AnimatePresence>\n\n          {/* Countdown Clock Face */}\n          <span className=\"text-3xl sm:text-4xl font-black font-mono tracking-tight text-stone-900 my-1.5 sm:my-2.5\">\n            {formattedMinutes}:{formattedSeconds}\n          </span>\n\n          {/* Device Face Feedback Statement */}\n          <div className=\"h-5\">\n            {activeFaceState === DeviceFaceState.FACE_DOWN ? (\n              <span className=\"text-[10px] text-stone-600 font-bold flex items-center gap-1.5\">\n                <span className=\"w-1.5 h-1.5 rounded-full bg-stone-800 animate-ping\" />\n                \346\255\243\345\234\250\350\256\241\346\227\266\344\270\255...\n              </span>\n            ) : activeFaceState === DeviceFaceState.FACE_UP ? (\n              <span className=\"text-[10px] text-stone-400 font-medium flex items-center gap-1.5\">\n                <span className=\"w-1.5 h-1.5 rounded-full bg-stone-300\" />\n                \345\261\217\345\271\225\345\220\221\344\270\212\357\274\232\346\232\202\345\201\234\344\270\255\n              </span>\n            ) : (\n              <span className=\"text-[10px] text-stone-400 flex items-center gap-1 justify-center\">\n                <ArrowDownCircle className=\"w-3.5 h-3.5\" />\n                \345\200\222\346\211\243\346\211\213\346\234\272\345\274\200\345\247\213\344\270\223\346\263\250\n              </span>\n            )}\n          </div>\n        </div>\n      </div>\n\n      {/* Dynamic Instruction Cards */}\n      <div className=\"w-full mt-2 md:mt-4 shrink-0\">\n        {/* Quick Help Tip */}\n        <div className=\"bg-[#FAF9F6] rounded-xl p-2.5 md:p-4 border border-stone-200/60 text-center\">\n          <h4 className=\"text-[10px] md:text-[11px] font-bold text-stone-700 flex items-center justify-center gap-1 mb-1\">\n            \346\223\215\344\275\234\346\214\207\345\215\227\n          </h4>\n          <p className=\"text-[9px] md:text-[10px] text-stone-500 leading-relaxed font-sans max-w-[280px] mx-auto\">\n            1. \346\227\213\350\275\254/\345\200\276\346\226\234\346\211\213\346\234\272\357\274\210\346\210\226\345\217\263\344\270\212\350\247\222\344\273\277\347\234\237\345\231\250\357\274\211\351\200\211\346\213\251\350\256\241\346\227\266\346\250\241\345\274\217<br />\n            2. \345\261\217\345\271\225<strong className=\"text-stone-700\">\345\200\222\346\211\243\351\235\242\346\234\235\344\270\213</strong>\357\274\214\345\215\263\345\217\257\345\274\200\345\247\213\346\210\226\346\201\242\345\244\215\350\256\241\346\227\266<br />\n            3. \345\261\217\345\271\225<strong className=\"text-stone-700\">\351\235\242\346\234\235\344\270\212\346\224\276\347\275\256</strong>\357\274\214\350\256\241\346\227\266\345\231\250\350\207\252\345\212\250\346\232\202\345\201\234\n          </p>\n        </div>\n\n        {/* Manual Overrides for testing and accessibility fallback */}\n        <div className=\"flex justify-center items-center gap-3 mt-3 md:mt-4 pt-2 md:pt-3 border-t border-stone-100\">\n          <button\n            onClick={() => setIsTimerRunning(!isTimerRunning)}\n            className={`flex items-center gap-1.5 py-1.5 px-3.5 rounded-xl text-xs font-semibold transition-all border ${\n              isTimerRunning \n                ? \"bg-white hover:bg-stone-50 text-stone-700 border-stone-200\"\n                : \"bg-stone-900 hover:bg-stone-800 text-stone-50 border-stone-900\"\n            }`}\n          >\n            {isTimerRunning ? <Pause className=\"w-3 h-3\" /> : <Play className=\"w-3 h-3\" />}\n            {isTimerRunning ? \"\346\211\213\345\212\250\346\232\202\345\201\234\" : \"\346\211\213\345\212\250\345\274\200\345\247\213\"}\n          </button>\n\n          <button\n            onClick={() => {\n              setTimeLeft(currentMode.duration * 60);\n              setIsTimerRunning(false);\n            }}\n            className=\"flex items-center gap-1.5 py-1.5 px-3.5 rounded-xl text-xs font-semibold bg-stone-100 hover:bg-stone-200 text-stone-700 transition-all border border-transparent\"\n          >\n            <RotateCcw className=\"w-3 h-3\" />\n            \351\207\215\347\275\256\n          </button>\n        </div>\n      </div>"
