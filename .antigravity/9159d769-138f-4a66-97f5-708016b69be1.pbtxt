    instruction: "Simplify the top header, the bottom footer tabs, and enforce a strict single-screen height container to prevent overflow scrolling."
    replacement_infos {
      original_chunk {
        target_content: "  const minutes = Math.floor(timeLeft / 60);\n  const seconds = timeLeft % 60;\n  const formattedTime = `${minutes.toString().padStart(2, \"0\")}:${seconds.toString().padStart(2, \"0\")}`;\n\n  return (\n    <div className=\"min-h-screen flex flex-col justify-between bg-[#FDFBF7] text-stone-800 font-sans\">\n      \n      {/* 1. Header Navigation */}\n      <header className=\"border-b border-stone-200/60 bg-[#FDFBF7]/90 backdrop-blur-md sticky top-0 z-40 px-6 py-4\">\n        <div className=\"max-w-7xl mx-auto flex items-center justify-between\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-9 h-9 rounded-xl bg-stone-100 border border-stone-200/80 flex items-center justify-center text-stone-700\">\n              <TimerIcon className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <h1 className=\"text-sm font-bold tracking-tight text-stone-900 flex items-center gap-1.5\">\n                \351\207\215\345\212\233\350\256\241\346\227\266\345\231\250 \n                <span className=\"text-[9px] font-mono bg-stone-100 text-stone-600 border border-stone-200 px-1.5 py-0.5 rounded uppercase font-semibold\">\n                  PWA\n                </span>\n              </h1>\n              <p className=\"text-[10px] text-stone-500\">\n                \346\236\201\347\256\200\347\211\251\347\220\206\346\204\237\345\272\224\357\274\232\345\200\222\346\211\243\345\274\200\345\247\213\350\256\241\346\227\266\357\274\214\347\277\273\351\235\242\350\207\252\345\212\250\346\232\202\345\201\234\n              </p>\n            </div>\n          </div>\n\n          {/* Quick mode indicators */}\n          <div className=\"hidden md:flex items-center gap-3\">\n            <button\n              onClick={() => {\n                setSensorData(prev => ({\n                  ...prev,\n                  usingSimulator: !prev.usingSimulator\n                }));\n                resumeAudio();\n              }}\n              className={`flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium transition-all border ${\n                sensorData.usingSimulator\n                  ? \"bg-stone-900 text-stone-50 border-stone-900\"\n                  : \"bg-white text-stone-600 border-stone-200 hover:bg-stone-50\"\n              }`}\n            >\n              <Smartphone className=\"w-3.5 h-3.5\" />\n              {sensorData.usingSimulator ? \"\350\231\232\346\213\237\351\207\215\345\212\233\346\277\200\346\264\273\" : \"\346\265\213\350\257\225 3D \346\250\241\346\213\237\345\231\250\"}\n            </button>\n          </div>\n        </div>\n      </header>\n\n      {/* 2. Main Content Body */}\n      <main className=\"flex-1 max-w-7xl w-full mx-auto p-4 md:p-6 lg:p-8 flex flex-col justify-center\">\n        \n        {/* DESKTOP VIEWPORT: Gorgeous Bento dashboard displaying all modules together */}\n        <div className=\"hidden md:grid md:grid-cols-12 md:gap-6 lg:gap-8 items-stretch\">\n          \n          {/* Left Column: 3D Phone Simulator */}\n          <section className=\"col-span-4 flex flex-col justify-between\">\n            <PhoneSimulator\n              sensorData={sensorData}\n              setSensorData={setSensorData}\n              activeDirection={activeDirection}\n              activeFaceState={activeFaceState}\n              modes={settings.modes}\n              timeLeft={timeLeft}\n              formattedTime={formattedTime}\n              isTimerRunning={isTimerRunning}\n            />\n          </section>\n\n          {/* Center Column: Gravity Timer Clock Face */}\n          <section className=\"col-span-4 flex flex-col justify-between\">\n            <GravityTimer\n              settings={settings}\n              setSettings={setSettings}\n              activeDirection={activeDirection}\n              activeFaceState={activeFaceState}\n              timeLeft={timeLeft}\n              setTimeLeft={setTimeLeft}\n              isTimerRunning={isTimerRunning}\n              setIsTimerRunning={setIsTimerRunning}\n              addHistoryLog={addHistoryLog}\n              requestSensorPermissions={requestSensorPermissions}\n              sensorPermissionState={sensorPermissionState}\n            />\n          </section>\n\n          {/* Right Column: Dynamic Tabs for Stats or Settings */}\n          <section className=\"col-span-4 flex flex-col\">\n            <div className=\"flex-1 flex flex-col gap-4\">\n              <div className=\"grid grid-cols-2 p-1 bg-stone-100 border border-stone-200/60 rounded-xl\">\n                <button\n                  onClick={() => setActiveTab(\"stats\")}\n                  className={`py-2 text-xs font-semibold rounded-lg flex items-center justify-center gap-1.5 transition-all ${\n                    activeTab === \"stats\" || activeTab === \"timer\" || activeTab === \"simulator\"\n                      ? \"bg-white text-stone-900 shadow-sm border border-stone-200/40\"\n                      : \"text-stone-500 hover:text-stone-800\"\n                  }`}\n                >\n                  <BarChart3 className=\"w-3.5 h-3.5 text-stone-600\" />\n                  \345\216\206\345\217\262\347\273\237\350\256\241\n                </button>\n                <button\n                  onClick={() => setActiveTab(\"settings\")}\n                  className={`py-2 text-xs font-semibold rounded-lg flex items-center justify-center gap-1.5 transition-all ${\n                    activeTab === \"settings\"\n                      ? \"bg-white text-stone-900 shadow-sm border border-stone-200/40\"\n                      : \"text-stone-500 hover:text-stone-800\"\n                  }`}\n                >\n                  <SettingsIcon className=\"w-3.5 h-3.5 text-stone-600\" />\n                  \346\250\241\345\274\217\351\205\215\347\275\256\n                </button>\n              </div>\n\n              <div className=\"flex-1\">\n                {activeTab === \"settings\" ? (\n                  <SettingsPanel\n                    settings={settings}\n                    setSettings={setSettings}\n                    resetToDefaults={resetToDefaults}\n                  />\n                ) : (\n                  <HistoryStats\n                    historyLogs={historyLogs}\n                    clearHistory={clearHistory}\n                  />\n                )}\n              </div>\n            </div>\n          </section>\n        </div>\n\n        {/* MOBILE VIEWPORT: Single interactive focus pane with responsive bottom navbar */}\n        <div className=\"md:hidden flex-1 flex flex-col justify-center\">\n          <AnimatePresence mode=\"wait\">\n            <motion.div\n              key={activeTab}\n              initial={{ opacity: 0, y: 10 }}\n              animate={{ opacity: 1, y: 0 }}\n              exit={{ opacity: 0, y: -10 }}\n              transition={{ duration: 0.15 }}\n              className=\"flex-1 flex flex-col\"\n            >\n              {activeTab === \"timer\" && (\n                <GravityTimer\n                  settings={settings}\n                  setSettings={setSettings}\n                  activeDirection={activeDirection}\n                  activeFaceState={activeFaceState}\n                  timeLeft={timeLeft}\n                  setTimeLeft={setTimeLeft}\n                  isTimerRunning={isTimerRunning}\n                  setIsTimerRunning={setIsTimerRunning}\n                  addHistoryLog={addHistoryLog}\n                  requestSensorPermissions={requestSensorPermissions}\n                  sensorPermissionState={sensorPermissionState}\n                />\n              )}\n\n              {activeTab === \"simulator\" && (\n                <PhoneSimulator\n                  sensorData={sensorData}\n                  setSensorData={setSensorData}\n                  activeDirection={activeDirection}\n                  activeFaceState={activeFaceState}\n                  modes={settings.modes}\n                  timeLeft={timeLeft}\n                  formattedTime={formattedTime}\n                  isTimerRunning={isTimerRunning}\n                />\n              )}\n\n              {activeTab === \"stats\" && (\n                <HistoryStats\n                  historyLogs={historyLogs}\n                  clearHistory={clearHistory}\n                />\n              )}\n\n              {activeTab === \"settings\" && (\n                <SettingsPanel\n                  settings={settings}\n                  setSettings={setSettings}\n                  resetToDefaults={resetToDefaults}\n                />\n              )}\n            </motion.div>\n          </AnimatePresence>\n        </div>\n      </main>\n\n      {/* 3. Mobile Bottom Tab Bar */}\n      <footer className=\"md:hidden border-t border-stone-200/60 bg-[#FDFBF7]/95 sticky bottom-0 z-40 pb-safe-bottom\">\n        <nav className=\"flex justify-around items-center py-2.5 px-4 max-w-md mx-auto\">\n          {/* Timer Tab */}\n          <button\n            onClick={() => setActiveTab(\"timer\")}\n            className={`flex flex-col items-center gap-1 py-1 px-3 rounded-xl transition-all ${\n              activeTab === \"timer\" ? \"text-stone-950 font-bold\" : \"text-stone-400\"\n            }`}\n          >\n            <TimerIcon className=\"w-5 h-5\" />\n            <span className=\"text-[10px] font-semibold\">\350\256\241\346\227\266\345\231\250</span>\n          </button>\n\n          {/* Simulator Tab */}\n          <button\n            onClick={() => setActiveTab(\"simulator\")}\n            className={`flex flex-col items-center gap-1 py-1 px-3 rounded-xl transition-all ${\n              activeTab === \"simulator\" ? \"text-stone-950 font-bold\" : \"text-stone-400\"\n            }`}\n          >\n            <Smartphone className=\"w-5 h-5\" />\n            <span className=\"text-[10px] font-semibold\">\350\231\232\346\213\2373D</span>\n          </button>\n\n          {/* Stats Tab */}\n          <button\n            onClick={() => setActiveTab(\"stats\")}\n            className={`flex flex-col items-center gap-1 py-1 px-3 rounded-xl transition-all ${\n              activeTab === \"stats\" ? \"text-stone-950 font-bold\" : \"text-stone-400\"\n            }`}\n          >\n            <BarChart3 className=\"w-5 h-5\" />\n            <span className=\"text-[10px] font-semibold\">\347\273\237\350\256\241</span>\n          </button>\n\n          {/* Settings Tab */}\n          <button\n            onClick={() => setActiveTab(\"settings\")}\n            className={`flex flex-col items-center gap-1 py-1 px-3 rounded-xl transition-all ${\n              activeTab === \"settings\" ? \"text-stone-950 font-bold\" : \"text-stone-400\"\n            }`}\n          >\n            <SettingsIcon className=\"w-5 h-5\" />\n            <span className=\"text-[10px] font-semibold\">\351\205\215\347\275\256</span>\n          </button>\n        </nav>\n      </footer>\n    </div>\n  );\n}"
        replacement_content: "  return (\n    <div className=\"h-screen h-[100dvh] flex flex-col bg-[#FDFBF7] text-stone-800 font-sans overflow-hidden\">\n      \n      {/* 1. Header Navigation - Ultra Minimalist & Compact */}\n      <header className=\"border-b border-stone-200/50 bg-[#FDFBF7]/90 backdrop-blur-md sticky top-0 z-40 px-4 py-2.5\">\n        <div className=\"max-w-7xl mx-auto flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <TimerIcon className=\"w-4 h-4 text-stone-800\" />\n            <h1 className=\"text-xs font-bold tracking-wider text-stone-900 uppercase\">\n              \351\207\215\345\212\233\350\256\241\346\227\266\n            </h1>\n            <span className=\"text-[8px] font-mono bg-stone-100 text-stone-500 border border-stone-200/60 px-1 py-0.5 rounded uppercase font-semibold\">\n              PWA\n            </span>\n          </div>\n\n          {/* Quick mode indicators */}\n          <div className=\"flex items-center gap-2\">\n            <button\n              onClick={() => {\n                setSensorData(prev => ({\n                  ...prev,\n                  usingSimulator: !prev.usingSimulator\n                }));\n                resumeAudio();\n              }}\n              className={`flex items-center gap-1 px-2.5 py-1 rounded-md text-[10px] font-bold tracking-wide transition-all border ${\n                sensorData.usingSimulator\n                  ? \"bg-stone-900 text-stone-50 border-stone-900\"\n                  : \"bg-white text-stone-600 border-stone-200 hover:bg-stone-50\"\n              }`}\n            >\n              <Smartphone className=\"w-3 h-3\" />\n              {sensorData.usingSimulator ? \"\350\231\232\346\213\237\346\250\241\345\274\217\" : \"3D \344\273\277\347\234\237\"}\n            </button>\n          </div>\n        </div>\n      </header>\n\n      {/* 2. Main Content Body - Single Screen Contained */}\n      <main className=\"flex-1 max-w-7xl w-full mx-auto p-3 md:p-6 lg:p-8 flex flex-col min-h-0 overflow-hidden justify-center\">\n        \n        {/* DESKTOP VIEWPORT: Gorgeous Bento dashboard displaying all modules together */}\n        <div className=\"hidden md:grid md:grid-cols-12 md:gap-6 lg:gap-8 items-stretch flex-1 min-h-0 overflow-hidden\">\n          \n          {/* Left Column: 3D Phone Simulator */}\n          <section className=\"col-span-4 flex flex-col min-h-0 overflow-hidden\">\n            <PhoneSimulator\n              sensorData={sensorData}\n              setSensorData={setSensorData}\n              activeDirection={activeDirection}\n              activeFaceState={activeFaceState}\n              modes={settings.modes}\n              timeLeft={timeLeft}\n              formattedTime={formattedTime}\n              isTimerRunning={isTimerRunning}\n            />\n          </section>\n\n          {/* Center Column: Gravity Timer Clock Face */}\n          <section className=\"col-span-4 flex flex-col min-h-0 overflow-hidden\">\n            <GravityTimer\n              settings={settings}\n              setSettings={setSettings}\n              activeDirection={activeDirection}\n              activeFaceState={activeFaceState}\n              timeLeft={timeLeft}\n              setTimeLeft={setTimeLeft}\n              isTimerRunning={isTimerRunning}\n              setIsTimerRunning={setIsTimerRunning}\n              addHistoryLog={addHistoryLog}\n              requestSensorPermissions={requestSensorPermissions}\n              sensorPermissionState={sensorPermissionState}\n            />\n          </section>\n\n          {/* Right Column: Dynamic Tabs for Stats or Settings */}\n          <section className=\"col-span-4 flex flex-col min-h-0 overflow-hidden\">\n            <div className=\"flex-1 flex flex-col gap-3 min-h-0 overflow-hidden\">\n              <div className=\"grid grid-cols-2 p-1 bg-stone-100 border border-stone-200/60 rounded-xl shrink-0\">\n                <button\n                  onClick={() => setActiveTab(\"stats\")}\n                  className={`py-1.5 text-xs font-semibold rounded-lg flex items-center justify-center gap-1.5 transition-all ${\n                    activeTab === \"stats\" || activeTab === \"timer\" || activeTab === \"simulator\"\n                      ? \"bg-white text-stone-900 shadow-sm border border-stone-200/40\"\n                      : \"text-stone-500 hover:text-stone-800\"\n                  }`}\n                >\n                  <BarChart3 className=\"w-3.5 h-3.5 text-stone-600\" />\n                  \345\216\206\345\217\262\347\273\237\350\256\241\n                </button>\n                <button\n                  onClick={() => setActiveTab(\"settings\")}\n                  className={`py-1.5 text-xs font-semibold rounded-lg flex items-center justify-center gap-1.5 transition-all ${\n                    activeTab === \"settings\"\n                      ? \"bg-white text-stone-900 shadow-sm border border-stone-200/40\"\n                      : \"text-stone-500 hover:text-stone-800\"\n                  }`}\n                >\n                  <SettingsIcon className=\"w-3.5 h-3.5 text-stone-600\" />\n                  \346\250\241\345\274\217\351\205\215\347\275\256\n                </button>\n              </div>\n\n              <div className=\"flex-1 min-h-0 overflow-hidden\">\n                {activeTab === \"settings\" ? (\n                  <SettingsPanel\n                    settings={settings}\n                    setSettings={setSettings}\n                    resetToDefaults={resetToDefaults}\n                  />\n                ) : (\n                  <HistoryStats\n                    historyLogs={historyLogs}\n                    clearHistory={clearHistory}\n                  />\n                )}\n              </div>\n            </div>\n          </section>\n        </div>\n\n        {/* MOBILE VIEWPORT: Single interactive focus pane with responsive bottom navbar */}\n        <div className=\"md:hidden flex-1 flex flex-col min-h-0 overflow-hidden\">\n          <AnimatePresence mode=\"wait\">\n            <motion.div\n              key={activeTab}\n              initial={{ opacity: 0, y: 10 }}\n              animate={{ opacity: 1, y: 0 }}\n              exit={{ opacity: 0, y: -10 }}\n              transition={{ duration: 0.15 }}\n              className=\"flex-1 flex flex-col min-h-0 overflow-hidden justify-center\"\n            >\n              {activeTab === \"timer\" && (\n                <GravityTimer\n                  settings={settings}\n                  setSettings={setSettings}\n                  activeDirection={activeDirection}\n                  activeFaceState={activeFaceState}\n                  timeLeft={timeLeft}\n                  setTimeLeft={setTimeLeft}\n                  isTimerRunning={isTimerRunning}\n                  setIsTimerRunning={setIsTimerRunning}\n                  addHistoryLog={addHistoryLog}\n                  requestSensorPermissions={requestSensorPermissions}\n                  sensorPermissionState={sensorPermissionState}\n                />\n              )}\n\n              {activeTab === \"simulator\" && (\n                <PhoneSimulator\n                  sensorData={sensorData}\n                  setSensorData={setSensorData}\n                  activeDirection={activeDirection}\n                  activeFaceState={activeFaceState}\n                  modes={settings.modes}\n                  timeLeft={timeLeft}\n                  formattedTime={formattedTime}\n                  isTimerRunning={isTimerRunning}\n                />\n              )}\n\n              {activeTab === \"stats\" && (\n                <HistoryStats\n                  historyLogs={historyLogs}\n                  clearHistory={clearHistory}\n                />\n              )}\n\n              {activeTab === \"settings\" && (\n                <SettingsPanel\n                  settings={settings}\n                  setSettings={setSettings}\n                  resetToDefaults={resetToDefaults}\n                />\n              )}\n            </motion.div>\n          </AnimatePresence>\n        </div>\n      </main>\n\n      {/* 3. Mobile Bottom Tab Bar - Ultra Minimalist Segmented Panel */}\n      <footer className=\"md:hidden border-t border-stone-200/40 bg-[#FDFBF7]/90 backdrop-blur-md sticky bottom-0 z-40 pb-safe-bottom\">\n        <nav className=\"flex justify-around items-center py-2 px-2 max-w-md mx-auto\">\n          {/* Timer Tab */}\n          <button\n            onClick={() => setActiveTab(\"timer\")}\n            className={`flex flex-col items-center gap-1 py-1.5 px-4 rounded-xl transition-all ${\n              activeTab === \"timer\" \n                ? \"text-stone-950 scale-105 font-bold\" \n                : \"text-stone-400 hover:text-stone-600\"\n            }`}\n          >\n            <TimerIcon className={`w-4 h-4 transition-transform duration-300 ${activeTab === \"timer\" ? \"stroke-[2.5px] text-stone-900\" : \"stroke-2\"}`} />\n            <span className=\"text-[9px] tracking-wider\">\350\256\241\346\227\266</span>\n          </button>\n\n          {/* Simulator Tab */}\n          <button\n            onClick={() => setActiveTab(\"simulator\")}\n            className={`flex flex-col items-center gap-1 py-1.5 px-4 rounded-xl transition-all ${\n              activeTab === \"simulator\" \n                ? \"text-stone-950 scale-105 font-bold\" \n                : \"text-stone-400 hover:text-stone-600\"\n            }`}\n          >\n            <Smartphone className={`w-4 h-4 transition-transform duration-300 ${activeTab === \"simulator\" ? \"stroke-[2.5px] text-stone-900\" : \"stroke-2\"}`} />\n            <span className=\"text-[9px] tracking-wider\">\346\250\241\346\213\237</span>\n          </button>\n\n          {/* Stats Tab */}\n          <button\n            onClick={() => setActiveTab(\"stats\")}\n            className={`flex flex-col items-center gap-1 py-1.5 px-4 rounded-xl transition-all ${\n              activeTab === \"stats\" \n                ? \"text-stone-950 scale-105 font-bold\" \n                : \"text-stone-400 hover:text-stone-600\"\n            }`}\n          >\n            <BarChart3 className={`w-4 h-4 transition-transform duration-300 ${activeTab === \"stats\" ? \"stroke-[2.5px] text-stone-900\" : \"stroke-2\"}`} />\n            <span className=\"text-[9px] tracking-wider\">\347\273\237\350\256\241</span>\n          </button>\n\n          {/* Settings Tab */}\n          <button\n            onClick={() => setActiveTab(\"settings\")}\n            className={`flex flex-col items-center gap-1 py-1.5 px-4 rounded-xl transition-all ${\n              activeTab === \"settings\" \n                ? \"text-stone-950 scale-105 font-bold\" \n                : \"text-stone-400 hover:text-stone-600\"\n            }`}\n          >\n            <SettingsIcon className={`w-4 h-4 transition-transform duration-300 ${activeTab === \"settings\" ? \"stroke-[2.5px] text-stone-900\" : \"stroke-2\"}`} />\n            <span className=\"text-[9px] tracking-wider\">\351\205\215\347\275\256</span>\n          </button>\n        </nav>\n      </footer>\n    </div>\n  );\n}"
      }
      num_matches: 1
    }
  }
}
