rollbar-thumb-stone-200\">\n          {historyLogs.length === 0 ? (\n            <div className=\"h-full flex flex-col items-center justify-center text-center p-4 text-stone-400\">\n              <p className=\"text-xs\">\350\256\260\345\275\225\347\251\272\347\251\272\345\246\202\344\271\237\357\274\214\344\270\223\346\263\250\345\220\216\345\260\206\350\207\252\345\212\250\345\275\222\346\241\243</p>\n            </div>\n          ) : (\n            historyLogs.slice(0, 15).map((log) => {\n              return (\n                <div\n                  key={log.id}\n                  className=\"flex items-center justify-between p-2.5 rounded-xl bg-[#FAF9F6] border border-stone-200/60 hover:border-stone-300/80 transition-all\"\n                >\n                  <div className=\"flex items-center gap-2.5\">\n                    {log.completed ? (\n                      <CheckCircle className=\"w-3.5 h-3.5 text-stone-600 shrink-0\" />\n                    ) : (\n                      <XCircle className=\"w-3.5 h-3.5 text-stone-400 shrink-0\" />\n                    )}\n                    <div className=\"flex flex-col\">\n                      <span className=\"text-xs font-bold text-stone-800\">\n                        {log.modeLabel}\n                      </span>\n                      <span className=\"text-[9px] text-stone-400 font-mono\">\n                        {formatDateStr(log.timestamp)} @ {formatTimeStr(log.timestamp)}\n                      </span>\n                    </div>\n                  </div>\n\n                  <span className=\"text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-white text-stone-800 border border-stone-200\">\n                    +{log.durationMinutes}\345\210\206\n                  </span>\n                </div>\n              );\n            })\n          )}\n        </div>\n      </div>\n    </div>\n  );"
