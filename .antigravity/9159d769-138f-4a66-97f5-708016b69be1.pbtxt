       </div>\n        </div>\n\n        {/* Total Minutes Card */}\n        <div className=\"bg-[#FAF9F6] border border-stone-200/60 rounded-2xl p-3 flex flex-col justify-between\">\n          <span className=\"text-[10px] font-bold text-stone-500\">\347\264\257\350\256\241\344\270\223\346\263\250</span>\n          <div className=\"flex items-baseline gap-1 mt-2\">\n            <span className=\"text-2xl font-black font-mono text-stone-850\">\n              {totalFocusMinutes}\n            </span>\n            <span className=\"text-[10px] text-stone-400\">\345\210\206\351\222\237</span>\n          </div>\n        </div>\n\n        {/* Streaks Card */}\n        <div className=\"bg-[#FAF9F6] border border-stone-200/60 rounded-2xl p-3 flex flex-col justify-between\">\n          <span className=\"text-[10px] font-bold text-stone-500\">\350\277\236\347\273\255\345\244\251\346\225\260</span>\n          <div className=\"flex items-baseline gap-1 mt-2\">\n            <span className=\"text-2xl font-black font-mono text-stone-850 flex items-center gap-0.5\">\n              <Zap className=\"w-3.5 h-3.5 fill-stone-700 text-stone-700 inline\" />\n              {currentStreak}\n            </span>\n            <span className=\"text-[10px] text-stone-400\">\345\244\251</span>\n          </div>\n        </div>\n      </div>\n\n      {/* Mode Distribution Chart */}\n      <div className=\"bg-[#FAF9F6] border border-stone-200/60 rounded-2xl p-4 mb-5\">\n        <h3 className=\"text-[11px] font-bold text-stone-700 mb-3 flex items-center gap-1.5 uppercase tracking-wider\">\n          <Trophy className=\"w-3.5 h-3.5 text-stone-500\" />\n          \344\270\223\346\263\250\346\227\266\351\225\277\345\210\206\345\270\203\n        </h3>\n\n        {totalFocusMinutes === 0 ? (\n          <div className=\"text-center py-4 text-xs text-stone-400\">\n            \346\232\202\346\227\240\344\270\223\346\263\250\346\225\260\346\215\256\343\200\202\345\200\222\346\211\243\346\211\213\346\234\2