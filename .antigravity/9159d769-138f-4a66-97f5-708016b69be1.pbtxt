      replacement_content: "const CACHE_NAME = \"gravity-timer-v1\";\nconst ASSETS = [\n  \"./\",\n  \"./index.html\",\n  \"./src/main.tsx\",\n  \"./src/App.tsx\",\n  \"./src/index.css\"\n];\n\n// Install Event\nself.addEventListener(\"install\", (e) => {\n  e.waitUntil(\n    caches.open(CACHE_NAME).then((cache) => {\n      return cache.addAll(ASSETS).catch((err) => {\n        console.warn(\"Service Worker pre-caching warning:\", err);\n      });\n    })\n  );\n  self.skipWaiting();\n});\n\n// Activate Event\nself.addEventListener(\"activate\", (e) => {\n  e.waitUntil(\n    caches.keys().then((keys) => {\n      return Promise.all(\n        keys.map((key) => {\n          if (key !== CACHE_NAME) {\n            return caches.delete(key);\n          }\n        })\n      );\n    })\n  );\n  self.clients.claim();\n});\n\n// Fetch Event with network-falling-back-to-cache strategy\nself.addEventListener(\"fetch\", (e) => {\n  e.respondWith(\n    fetch(e.request).catch(() => {\n      return caches.match(e.request).then((res) => {\n        if (res) return res;\n        // Fallback for index html\n        if (e.request.mode === \"navigate\") {\n          return caches.match(\"./index.html\") || caches.match(\"./\");\n        }\n        return Promise.reject(\"Offline asset not found\");\n      });\n    })\n  );\n});\n"
