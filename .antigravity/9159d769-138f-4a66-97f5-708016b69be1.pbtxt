        }
        lines {
          text: "    const dates = completedLogs"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      .map((log) => new Date(log.timestamp).toDateString())"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      .filter((value, index, self) => self.indexOf(value) === index)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      .map((d) => new Date(d).getTime())"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      .sort((a, b) => b - a);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
