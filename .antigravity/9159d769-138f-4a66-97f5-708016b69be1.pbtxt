        }
        lines {
          text: "      const diff = dates[i] - dates[i + 1];"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      if (diff === oneDay) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        currentStreak++;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
